<?xml version="1.0" encoding="UTF-8"?>
<!--
  Réglages Maven de la CI : toutes les dépendances passent par Nexus (groupe maven-public).
  Aucun secret ici : l'URL et l'identifiant sont fournis par Jenkins (variables d'environnement).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <id>nexus</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>
    <mirrors>
        <mirror>
            <id>nexus</id>
            <mirrorOf>*</mirrorOf>
            <url>${env.NEXUS_URL}/repository/maven-public/</url>
        </mirror>
    </mirrors>
</settings>
