<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>fr.socle</groupId>
    <artifactId>socle-testapp</artifactId>
    <!-- Version « CI-friendly » : la CI passe -Drevision=1.0.<n° de build> -->
    <version>${revision}</version>
    <name>socle-testapp</name>
    <description>Application web factice servant de cible de validation au socle d'automatisation</description>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Même version que le Selenium Grid (4.48) -->
        <selenium.version>4.48.0</selenium.version>
        <jacoco.version>0.8.16</jacoco.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
        <flatten-maven-plugin.version>1.9.0</flatten-maven-plugin.version>
        <allure.version>2.35.6</allure.version>
        <!-- Résultats Allure du contrôle de fumée (la CI en utilise un par navigateur) -->
        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>

        <!-- Commit du build : « local » par défaut, celui de Jenkins via le profil ci-commit (variable GIT_COMMIT) -->
        <git.commit>local</git.commit>

        <!-- Permet de ne lancer que le contrôle de fumée : -DskipUnitTests=true -->
        <skipUnitTests>false</skipUnitTests>

        <!-- Sonar : projet et rapport de couverture JaCoCo -->
        <sonar.projectKey>fr.socle:socle-testapp</sonar.projectKey>
        <sonar.projectName>socle-testapp</sonar.projectName>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Le contrôle de fumée pilote un navigateur : il n'entre pas dans la couverture du code applicatif -->
        <sonar.coverage.exclusions>**/TestAppApplication.java</sonar.coverage.exclusions>
    </properties>

    <dependencies>
        <!-- Tomcat embarqué + Spring MVC + Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Tests unitaires : JUnit 5, MockMvc, AssertJ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Contrôle de fumée (profil smoke) : Selenium contre l'application déployée -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Rapport HTML Allure du contrôle de fumée -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nom stable du JAR : target/socle-testapp.jar -->
        <finalName>socle-testapp</finalName>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- META-INF/build-info.properties : version, date du build, commit (affichés par l'appli) -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <commit>${git.commit}</commit>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Remplace ${revision} par la vraie version dans le POM publié -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Tests unitaires (*Test.java) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>${skipUnitTests}</skip>
                    <systemPropertyVariables>
                        <!-- Résultats Allure des tests unitaires à part (non publiés) -->
                        <allure.results.directory>${project.build.directory}/allure-results-unit</allure.results.directory>
                    </systemPropertyVariables>
                    <excludes>
                        <exclude>**/smoke/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Couverture de code des tests unitaires -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Activé automatiquement dans Jenkins : le commit construit est inscrit dans la version affichée -->
        <profile>
            <id>ci-commit</id>
            <activation>
                <property>
                    <name>env.GIT_COMMIT</name>
                </property>
            </activation>
            <properties>
                <git.commit>${env.GIT_COMMIT}</git.commit>
            </properties>
        </profile>
        <!--
            Contrôle de fumée contre une application déjà lancée :
            mvn -Psmoke -DskipUnitTests=true verify -Dapp.url=http://testapp.home.arpa:8085 -Dgrid.url=http://grid.home.arpa:4444 -Dbrowser=chrome
            Sans grid.url, un navigateur local est utilisé.
        -->
        <profile>
            <id>smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/smoke/**/*IT.java</include>
                            </includes>
                            <!-- Rapports et synthèse propres à chaque navigateur : plusieurs exécutions
                                 (successives ou simultanées) ne s'écrasent pas -->
                            <reportsDirectory>${project.build.directory}/failsafe-reports-${browser}</reportsDirectory>
                            <summaryFile>${project.build.directory}/failsafe-summary-${browser}.xml</summaryFile>
                            <systemPropertyVariables>
                                <app.url>${app.url}</app.url>
                                <grid.url>${grid.url}</grid.url>
                                <browser>${browser}</browser>
                                <allure.results.directory>${allure.results.directory}</allure.results.directory>
                                <smoke.ralenti>${smoke.ralenti}</smoke.ralenti>
                                <app.expectedVersion>${app.expectedVersion}</app.expectedVersion>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <app.url>http://localhost:8080</app.url>
                <grid.url/>
                <browser>chrome</browser>
                <!-- Mode observation : pause (ms) après chaque geste, 0 = vitesse normale -->
                <smoke.ralenti>0</smoke.ralenti>
                <!-- Version attendue sur l'application déployée (fournie par la CI) ; vide = non vérifiée -->
                <app.expectedVersion/>
            </properties>
        </profile>
    </profiles>
</project>
